{
  "name": "kartinnsyn",
  "version": "1.0.0",
  "private": true,
  "description": "Skybasert kartinnsyn med MapLibre, PMTiles, Overture Maps og OpenStreetMap",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ai-demo/tsconfig.json",
    "kartlab:data": "node ai-demo/scripts/prepare-data.mjs",
    "kartlab:build": "tsc --noEmit -p ai-demo/tsconfig.json && node ai-demo/build.mjs",
    "kartlab:serve": "vite preview --outDir ai-demo/dist --port 4180 --open",
    "kartlab": "npm run kartlab:build && npm run kartlab:serve"
  },
  "dependencies": {
    "@geolibre/core": "3.3.0",
    "@geolibre/map": "3.3.0",
    "maplibre-gl": "6.13.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
